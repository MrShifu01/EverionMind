# ── Supabase — required server-side ───────────────────────────────────
# Project URL and keys from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-32-plus-random-chars
OAUTH_STATE_SECRET=replace-with-32-plus-random-chars

# Client-side Supabase — required public Vite values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Supabase staging ──────────────────────────────────────────────────
# Separate free-tier project so DDL changes can be tested before they hit
# production. Schema kept in sync via supabase/migrations/*.sql — apply
# new migrations to staging FIRST, then production.
#
# Project ID:  rsnrvebcjbstfxhkfsjq
# URL:         https://rsnrvebcjbstfxhkfsjq.supabase.co
# Anon key:    sb_publishable_2MsQ0-KFQone8o7jslkh9Q_DRlAkJ4x
# Service key: pull from https://supabase.com/dashboard/project/rsnrvebcjbstfxhkfsjq/settings/api
#
# To point a local dev shell at staging instead of prod, override the
# variables above in .env.local with the staging values.

# ── Gemini — required hosted AI provider ─────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── Optional AI provider/model overrides ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
GEMINI_CHAT_MODEL=gemini-3-flash-preview
GEMINI_BULK_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Default: gemini-2.5-flash-lite (hardcoded in .env, override with VITE_MODEL)
# VITE_MODEL=gemini-2.5-flash-lite

# ── Feature Flags — public Vite values ────────────────────────────────
VITE_ENABLE_MULTI_BRAIN=false
# Set to true to make the knowledge graph visible to all users
VITE_FEATURE_GRAPH=false
VITE_FEATURE_APP_LOCK=false
VITE_FEATURE_CHAT=true
VITE_FEATURE_CONTACTS=true
VITE_FEATURE_LISTS=true
VITE_FEATURE_TODOS=true
VITE_FEATURE_VAULT=true
VITE_FEATURE_VAULT_PIN_BIOMETRIC=false

# ── Upstash Redis — required in production rate limiting ─────────────
# From https://console.upstash.com — falls back to in-memory if not set
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── OAuth integrations — optional unless Gmail/Calendar ships ─────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/calendar-auth?provider=google
GMAIL_REDIRECT_URI=https://yourdomain.com/api/gmail-auth?provider=google
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=https://yourdomain.com/api/calendar-auth?provider=microsoft
MICROSOFT_TENANT_ID=common

# ── Web Push / Notifications — optional unless push ships ─────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Client-side VAPID public key (must match VAPID_PUBLIC_KEY above)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# ── Resend — required for email invites/digests ──────────────────────
RESEND_API_KEY=re_...
RESEND_FROM=Everion <noreply@yourdomain.com>

# ── Sentry (error monitoring) ─────────────────────────────────────────
# Get from https://sentry.io/settings/<org>/projects/<project>/keys/
# Omit or leave blank to disable Sentry in development
VITE_SENTRY_DSN=https://...@...ingest.sentry.io/...
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── App URL ───────────────────────────────────────────────────────────
# Used for invite links. Auto-detected on Vercel via VERCEL_URL if not set.
APP_URL=https://everionmind.com
VITE_APP_URL=https://everionmind.com
VITE_ADMIN_EMAIL=support@everionmind.com


# ── Cron Security ─────────────────────────────────────────────────────
# HMAC secret for authenticating cron endpoint calls
CRON_SECRET=your-cron-secret

# ── Search ────────────────────────────────────────────────────────────
# Similarity threshold for vector search (default 0.3)
SEARCH_THRESHOLD=0.3

# ── Billing — optional until paid tiers ship ──────────────────────────
LEMONSQUEEZY_API_KEY=ls_...
LEMONSQUEEZY_STORE_ID=12345
LEMONSQUEEZY_STARTER_VARIANT_ID=12345
LEMONSQUEEZY_PRO_VARIANT_ID=12346
LEMONSQUEEZY_MAX_VARIANT_ID=12347
LEMONSQUEEZY_WEBHOOK_SECRET=replace-with-webhook-secret
REVENUECAT_SECRET_API_KEY=rc_secret_...
REVENUECAT_WEBHOOK_AUTH=replace-with-webhook-auth
REVENUECAT_STARTER_PRODUCT_ID=starter
REVENUECAT_PRO_PRODUCT_ID=pro
REVENUECAT_MAX_PRODUCT_ID=max
VITE_REVENUECAT_API_KEY_IOS=appl_public_sdk_key
VITE_REVENUECAT_API_KEY_ANDROID=goog_public_sdk_key

# ── GitHub workflow dispatch — optional ops automation ────────────────
GH_DISPATCH_TOKEN=github_pat_...
GH_OWNER=your-org
GH_REPO=your-repo
ADMIN_EMAIL=admin@yourdomain.com

# Legacy tier-specific Gemini overrides are no longer needed. Managed chat uses
# GEMINI_CHAT_MODEL; background/bulk enrichment uses GEMINI_BULK_MODEL.

# ── Playwright e2e ─────────────────────────────────────────────────────────
# Real Supabase credentials Playwright signs in with via global-setup.ts.
# Put the actual values in .env.local (gitignored), never here.
E2E_ADMIN_EMAIL=admin@yourdomain.com
E2E_ADMIN_PASSWORD=your-admin-password
# Override if your dev server runs on a non-default port
# E2E_BASE_URL=http://localhost:5174
